  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "jest",
    "test:e2e": "cypress run",
    "test:e2e:ci": "start-server-and-test preview http://localhost:4173 \"cypress run\"",
    "lint": "eslint .",
